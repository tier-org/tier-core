#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Enable for boot, but do not start now: the operator reviews the node
    # config (/etc/tier/tierd.toml - roles, network, seeds) first, then starts.
    systemctl enable tierd.service >/dev/null 2>&1 || true
    echo "tierd: edit /etc/tier/tierd.toml, then: systemctl start tierd" >&2
fi

exit 0
