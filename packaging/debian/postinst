#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Enable for boot, but do not start now: the operator sets the bootstrap
    # seed in /etc/tier/tierd.env first, then starts the service.
    systemctl enable tierd.service >/dev/null 2>&1 || true
    echo "tierd: edit /etc/tier/tierd.env, then: systemctl start tierd" >&2
fi

exit 0
