[Unit]
Description=Tier node daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tier/tierd.env
# Long-term Ed25519 seed lives under the systemd StateDirectory (/var/lib/tier).
Environment=TIER_ID_FILE=%S/tier/node_key
ExecStart=/usr/bin/tierd $TIER_ARGS
Restart=on-failure
RestartSec=2

# Dedicated transient service account; persistent state in /var/lib/tier (0700).
DynamicUser=yes
StateDirectory=tier
StateDirectoryMode=0700
# Runtime dir for the local admin socket (/run/tierd/tierd.sock), service-owned.
RuntimeDirectory=tierd
RuntimeDirectoryMode=0750
# AF_UNIX below is required for that admin socket; without it socket() fails
# with EAFNOSUPPORT and the diagnostics socket is silently disabled.

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
